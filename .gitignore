# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and every contributor needs it.
!.env.example

# Plaintext account passwords written by scripts/import-registrations.mjs.
# Real people's credentials — distribute, then delete. Never commit.
*credentials*.csv

# The cleaned registration sheet written by scripts/prepare-registrations-csv.mjs.
# No passwords, but it is the raw form intake: phone numbers, food allergies and
# the free-text medical notes people were asked to disclose. Not ours to publish.
*registrations*.csv

# The same credentials as printable per-member slips. Each PDF carries a live
# password and a scannable entry QR. Ignored here as well as on the branch that
# generates them, because the directory already exists in working copies where
# that branch is not checked out — one `git add -A` away from being published.
/credential-slips/

# The participant ID list written by scripts/make-participant-id-list.mjs.
# It carries no credentials — that is the whole point of it — but it is still a
# roster of 77 named students with their college and their team, and this repo
# is public. Regenerate it from the database instead of committing it.
/codefest-2026-participant-ids.pdf

# The organising team and volunteer list written by scripts/make-staff-list-pdf.mjs.
# Same reasoning as the participant list above: no credentials on it, but it is
# still 27 named people and their portfolios, and this repo is public.
/codefest-2026-staff-list.pdf

# vercel
.vercel

# scratch state from multi-agent tooling runs, not project source
.agents

# typescript
*.tsbuildinfo
next-env.d.ts
