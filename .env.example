# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase -------------------------------------------------------------
# Project settings -> API. The anon key is safe to expose; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://bhmhmlmnynarswcqdaru.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — used to create member accounts and to grade
# quizzes against answer keys the browser must never see. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site -----------------------------------------------------------------
# The public origin. Identity-card QRs encode it, and a card is printed on
# paper: get this wrong and the badges are dead, which nobody discovers until
# a volunteer scans one at the desk.
#
# THIS MUST BE SET IN THE HOSTING ENVIRONMENT TOO, not only here. It is read at
# build time, and the fallback below is a localhost address — a deploy that
# omits it silently ships QR codes and share images pointing at nothing.
NEXT_PUBLIC_SITE_URL=https://codefestchitwan-2026.vercel.app

# --- SMTP (mailing members their password, and the public contact form) ----
# Without these, accounts are still created and the generated password is
# shown in the admin panel for the team to send manually. The public contact
# form refuses to claim delivery and points the sender at the address below.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM="Codefest Chitwan <no-reply@codefestnepal.com>"

# Where /contact enquiries are delivered. Defaults to EVENT.email
# (execution@codefestnepal.com) when unset.
CONTACT_INBOX=
