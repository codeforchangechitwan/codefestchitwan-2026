# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase -------------------------------------------------------------
# Project settings -> API. The anon key is safe to expose; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://bhmhmlmnynarswcqdaru.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — used to create member accounts and to grade
# quizzes against answer keys the browser must never see. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site -----------------------------------------------------------------
# Used for QR target URLs and email links. Must be the public origin in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- SMTP (mailing members their password) --------------------------------
# Without these, accounts are still created and the generated password is
# shown in the admin panel for the team to send manually.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM="Codefest Chitwan <no-reply@codefestnepal.com>"
